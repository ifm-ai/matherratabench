{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "benchmark-q1-semantic-issue-coverage-judgment-luna5",
  "title": "Luna.5 coherent discovery with distinct-defect combination",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "question_id",
    "status",
    "judge_run_name",
    "prediction_set_name",
    "paper_id",
    "judge_input_sha256",
    "gold_decisions",
    "audit"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "enum": [
        "benchmark-q1-semantic-issue-coverage-judgment-luna5"
      ]
    },
    "question_id": {
      "type": "string",
      "enum": [
        "Q1-semantic-issue-coverage"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "ok"
      ]
    },
    "judge_run_name": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9._-]+$"
    },
    "prediction_set_name": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9._-]+$"
    },
    "paper_id": {
      "type": "string",
      "pattern": "^[0-9]{4}\\.[0-9]{4,5}$"
    },
    "judge_input_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "gold_decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "gold_issue_id",
          "focus_prediction_issue_id",
          "focus_relation",
          "gold_causal_unit_ids",
          "prediction_causal_unit_ids",
          "same_causal_subject",
          "same_failed_obligation",
          "same_failure_operation",
          "identity_explanation",
          "shared_mathematical_weakness",
          "uncovered_gold_detail",
          "coverage_status",
          "supporting_prediction_issue_ids",
          "combination_explanation",
          "component_coverage"
        ],
        "properties": {
          "gold_issue_id": {
            "type": "string",
            "minLength": 1
          },
          "focus_prediction_issue_id": {
            "type": "string",
            "minLength": 1
          },
          "focus_relation": {
            "type": "string",
            "enum": [
              "same_causal_defect",
              "same_underlying_weakness",
              "shared_topic_or_location_only",
              "different_causal_subject",
              "different_obligation_or_hypothesis",
              "different_operation_step_or_formula",
              "upstream_downstream_only",
              "no_substantive_overlap"
            ]
          },
          "gold_causal_unit_ids": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "prediction_causal_unit_ids": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "same_causal_subject": {
            "type": "boolean"
          },
          "same_failed_obligation": {
            "type": "boolean"
          },
          "same_failure_operation": {
            "type": "boolean"
          },
          "identity_explanation": {
            "type": "string",
            "minLength": 1
          },
          "shared_mathematical_weakness": {
            "type": "string"
          },
          "uncovered_gold_detail": {
            "type": "string"
          },
          "coverage_status": {
            "type": "string",
            "enum": [
              "matched",
              "not_matched"
            ]
          },
          "supporting_prediction_issue_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "maxItems": 3
          },
          "combination_explanation": {
            "type": "string"
          },
          "component_coverage": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "gold_component": {
                  "type": "string",
                  "minLength": 1
                },
                "gold_causal_unit_ids": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "prediction_issue_id": {
                  "type": "string",
                  "minLength": 1
                },
                "prediction_causal_unit_ids": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "recognition_explanation": {
                  "type": "string",
                  "minLength": 1
                },
                "self_contained_diagnosis": {
                  "type": "boolean",
                  "const": true
                }
              },
              "required": [
                "gold_component",
                "gold_causal_unit_ids",
                "prediction_issue_id",
                "prediction_causal_unit_ids",
                "recognition_explanation",
                "self_contained_diagnosis"
              ]
            }
          }
        }
      }
    },
    "audit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "all_gold_ids_decided",
        "each_gold_credited_at_most_once",
        "prediction_reuse_requires_explicit_issue_support",
        "all_ranked_candidates_considered",
        "target_type_not_used_for_identity",
        "severity_not_used_for_identity",
        "combined_entries_are_self_contained_diagnoses",
        "support_limit_three_respected"
      ],
      "properties": {
        "all_gold_ids_decided": {
          "type": "boolean",
          "const": true
        },
        "all_ranked_candidates_considered": {
          "type": "boolean",
          "const": true
        },
        "target_type_not_used_for_identity": {
          "type": "boolean",
          "const": true
        },
        "severity_not_used_for_identity": {
          "type": "boolean",
          "const": true
        },
        "prediction_reuse_requires_explicit_issue_support": {
          "type": "boolean",
          "const": true
        },
        "each_gold_credited_at_most_once": {
          "type": "boolean",
          "const": true
        },
        "combined_entries_are_self_contained_diagnoses": {
          "type": "boolean",
          "const": true
        },
        "support_limit_three_respected": {
          "type": "boolean",
          "const": true
        }
      }
    }
  }
}
