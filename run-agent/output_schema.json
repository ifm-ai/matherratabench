{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "benchmark-q1-issue-inventory-prediction-v1",
  "title": "Q1 substantive mathematical issue inventory prediction",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "question_id",
    "status",
    "run_name",
    "paper_id",
    "source_sha256",
    "issues_found",
    "issues",
    "error"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "enum": ["benchmark-q1-issue-inventory-prediction-v1"]
    },
    "question_id": {
      "type": "string",
      "enum": ["Q1"]
    },
    "status": {
      "type": "string",
      "enum": ["ok", "input_error"]
    },
    "run_name": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9._-]+$"
    },
    "paper_id": {
      "type": "string",
      "pattern": "^[0-9]{4}\\.[0-9]{4,5}$"
    },
    "source_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "issues_found": {
      "type": "integer",
      "minimum": 0
    },
    "issues": {
      "type": "array",
      "maxItems": 999,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "issue_id",
          "title",
          "target_type",
          "primary_affected_tag",
          "failure_mechanism",
          "failure_location",
          "diagnostic_evidence",
          "failure_explanation",
          "dependent_affected_formal_result_tags",
          "overall_effect",
          "least_adequate_overall_repair",
          "classification",
          "why_classification"
        ],
        "properties": {
          "issue_id": {
            "type": "string",
            "pattern": "^ISSUE-[0-9]{3}$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "target_type": {
            "type": "string",
            "enum": [
              "formal_result",
              "algorithm",
              "prose_claim",
              "other"
            ]
          },
          "primary_affected_tag": {
            "type": ["string", "null"],
            "minLength": 1
          },
          "failure_mechanism": {
            "type": "string",
            "enum": [
              "statement_support_mismatch",
              "invalid_input_or_dependency",
              "invalid_or_incomplete_reasoning",
              "other",
              "not_applicable"
            ]
          },
          "failure_location": {
            "type": "object",
            "additionalProperties": false,
            "required": ["tag", "quote"],
            "properties": {
              "tag": {
                "type": ["string", "null"],
                "minLength": 1
              },
              "quote": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "diagnostic_evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["tag", "quote"],
              "properties": {
                "tag": {
                  "type": ["string", "null"],
                  "minLength": 1
                },
                "quote": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          },
          "failure_explanation": {
            "type": "string",
            "minLength": 1
          },
          "dependent_affected_formal_result_tags": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "overall_effect": {
            "type": "string",
            "minLength": 1
          },
          "least_adequate_overall_repair": {
            "type": "string",
            "minLength": 1
          },
          "classification": {
            "type": "string",
            "enum": [
              "minor_issue",
              "moderate_issue",
              "serious_issue"
            ]
          },
          "why_classification": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "error": {
      "type": ["string", "null"],
      "minLength": 1
    }
  }
}
