01","focus_relation":"different_operation_step_or_formula","gold_causal_unit_ids":["2512.24405:I008:U001","2512.24405:I008:U003","2512.24405:I008:U004"],"prediction_causal_unit_ids":["ISSUE-001:U001","ISSUE-001:U003","ISSUE-001:U007"],"same_causal_subject":false,"same_failed_obligation":false,"same_failure_operation":false,"identity_explanation":"The gold issue is a sign error in the expansion of a conjugate Frobenius pairing, which invalidates two tailored contradiction witnesses and the intra-pair orthogonality proof. ISSUE-001 is a separate malformed operator-norm display and does not recognize this quadratic-form sign error or its proof consequences.","shared_mathematical_weakness":"","uncovered_gold_detail":"","coverage_status":"not_matched","supporting_prediction_issue_ids":[],"combination_explanation":"","component_coverage":[]},{"gold_issue_id":"2512.24405:I009","focus_prediction_issue_id":"ISSUE-003","focus_relation":"different_causal_subject","gold_causal_unit_ids":["2512.24405:I009:U001","2512.24405:I009:U003","2512.24405:I009:U005"],"prediction_causal_unit_ids":["ISSUE-003:U001","ISSUE-003:U008","ISSUE-003:U011"],"same_causal_subject":false,"same_failed_obligation":false,"same_failure_operation":false,"identity_explanation":"The gold issue concerns a false universal compression-count comparison under nonuniform row scaling and an incorrect identification of transformed energy with original-domain energy. ISSUE-003 concerns missing cases in an idempotent-component row-orthogonality proof, with no diagnosis of scaling or compression thresholds.","shared_mathematical_weakness":"","uncovered_gold_detail":"","coverage_status":"not_matched","supporting_prediction_issue_ids":[],"combination_explanation":"","component_coverage":[]}],"audit":{"all_gold_ids_decided":true,"all_ranked_candidates_considered":true,"target_type_not_used_for_identity":true,"severity_not_used_for_identity":true,"prediction_reuse_requires_explicit_issue_support":true,"each_gold_credited_a