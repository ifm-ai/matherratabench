y the quadrature proof.","shared_mathematical_weakness":"","uncovered_gold_detail":"","coverage_status":"not_matched","supporting_prediction_issue_ids":[],"combination_explanation":"","component_coverage":[]},{"gold_issue_id":"2511.02700:I004","focus_prediction_issue_id":"ISSUE-001","focus_relation":"different_obligation_or_hypothesis","gold_causal_unit_ids":["2511.02700:I004:U001","2511.02700:I004:U002","2511.02700:I004:U007"],"prediction_causal_unit_ids":["ISSUE-001:U005","ISSUE-001:U008"],"same_causal_subject":false,"same_failed_obligation":false,"same_failure_operation":false,"identity_explanation":"The gold issue is that singular positive-semidefinite rho makes inverse- and determinant-based NTS density formulas undefined, requiring a positive-definiteness premise. ISSUE-001 discusses norm-dependent exponential-rate assumptions and moment conditions; it does not recognize the inadmissibility or undefinedness of singular rho in those formulas.","shared_mathematical_weakness":"","uncovered_gold_detail":"","coverage_status":"not_matched","supporting_prediction_issue_ids":[],"combination_explanation":"","component_coverage":[]}],"audit":{"all_gold_ids_decided":true,"all_ranked_candidates_considered":true,"target_type_not_used_for_identity":true,"severity_not_used_for_identity":true,"prediction_reuse_requires_explicit_issue_support":true,"each_gold_credited_at_most_once":true,"combined_entries_are_self_contained_diagnoses":true,"support_limit_three_respected":true}}