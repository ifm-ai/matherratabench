ons behind the gold estimate.","shared_mathematical_weakness":"","uncovered_gold_detail":"","coverage_status":"not_matched","supporting_prediction_issue_ids":[],"combination_explanation":"","component_coverage":[]},{"gold_issue_id":"2409.01211:I004","focus_prediction_issue_id":"ISSUE-003","focus_relation":"different_operation_step_or_formula","gold_causal_unit_ids":["2409.01211:I004:U001","2409.01211:I004:U002","2409.01211:I004:U003"],"prediction_causal_unit_ids":["ISSUE-003:U001","ISSUE-003:U003","ISSUE-003:U004"],"same_causal_subject":false,"same_failed_obligation":false,"same_failure_operation":false,"identity_explanation":"The gold issue concerns applying a radius lemma requiring D>2 while claiming all h, leaving the D<=2 case unproved. ISSUE-003 concerns boundary-cell protrusion and inadequate tail regions in bounded-domain consistency estimates; it does not diagnose the missing D<=2 case or the invalid lemma invocation.","shared_mathematical_weakness":"","uncovered_gold_detail":"","coverage_status":"not_matched","supporting_prediction_issue_ids":[],"combination_explanation":"","component_coverage":[]}],"audit":{"all_gold_ids_decided":true,"all_ranked_candidates_considered":true,"target_type_not_used_for_identity":true,"severity_not_used_for_identity":true,"prediction_reuse_requires_explicit_issue_support":true,"each_gold_credited_at_most_once":true,"combined_entries_are_self_contained_diagnoses":true,"support_limit_three_respected":true}}