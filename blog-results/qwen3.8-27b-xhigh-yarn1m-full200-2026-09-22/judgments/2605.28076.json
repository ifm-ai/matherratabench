asurements, not multiplicity correction or the stated diagnostic decision boundary.","shared_mathematical_weakness":"","uncovered_gold_detail":"","coverage_status":"not_matched","supporting_prediction_issue_ids":[],"combination_explanation":"","component_coverage":[]}],"audit":{"all_gold_ids_decided":true,"all_ranked_candidates_considered":true,"target_type_not_used_for_identity":true,"severity_not_used_for_identity":true,"prediction_reuse_requires_explicit_issue_support":true,"each_gold_credited_at_most_once":true,"combined_entries_are_self_contained_diagnoses":true,"support_limit_three_respected":true}}