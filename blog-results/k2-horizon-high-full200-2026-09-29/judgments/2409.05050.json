al_weakness":"","uncovered_gold_detail":"","coverage_status":"not_matched","supporting_prediction_issue_ids":[],"combination_explanation":"","component_coverage":[]},{"gold_issue_id":"2409.05050:I007","focus_prediction_issue_id":"ISSUE-001","focus_relation":"different_operation_step_or_formula","gold_causal_unit_ids":["2409.05050:I007:U001","2409.05050:I007:U002","2409.05050:I007:U004","2409.05050:I007:U010"],"prediction_causal_unit_ids":["ISSUE-001:U001","ISSUE-001:U006"],"same_causal_subject":false,"same_failed_obligation":false,"same_failure_operation":false,"identity_explanation":"The gold issue concerns the affine Jacobi weight formula, undefined normalization factors, and inverse-weight summability. ISSUE-001 concerns least-squares sampling bounds and sharp eigenvalue drops; it does not recognize the missing affine weight normalization or its summability contract.","shared_mathematical_weakness":"","uncovered_gold_detail":"","coverage_status":"not_matched","supporting_prediction_issue_ids":[],"combination_explanation":"","component_coverage":[]}],"audit":{"all_gold_ids_decided":true,"all_ranked_candidates_considered":true,"target_type_not_used_for_identity":true,"severity_not_used_for_identity":true,"prediction_reuse_requires_explicit_issue_support":true,"each_gold_credited_at_most_once":true,"combined_entries_are_self_contained_diagnoses":true,"support_limit_three_respected":true}}